# Copy to .env for local development. Never commit the real .env.

# Local dev: any non-empty value works. Production: a strong, unique secret.
DJANGO_SECRET_KEY=dev-only-change-me

# True locally, False in production.
DEBUG=True

# Leave blank locally to use SQLite. Required in production (Railway sets it
# from the PostgreSQL service).
DATABASE_URL=

# Comma-separated hostnames, no scheme. Add your Railway domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins including https:// . Set to your Railway URL in prod.
CSRF_TRUSTED_ORIGINS=
